<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Heading above each group of inputs. -->
    <style name="Widget.BMICalculator.SectionTitle" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">@dimen/item_spacing</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
        <item name="android:accessibilityHeading">true</item>
    </style>

    <!--
        Single-choice unit selector: equal segments on one rounded track, drawn with the sliding
        pill by SlidingSelectionIndicator. A fractional inner corner keeps every ripple round.
    -->
    <style name="Widget.BMICalculator.UnitToggleGroup" parent="Widget.Material3.MaterialButtonToggleGroup">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">@dimen/field_spacing</item>
        <item name="android:padding">@dimen/unit_toggle_track_padding</item>
        <item name="singleSelection">true</item>
        <item name="selectionRequired">true</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Material3.Corner.Full</item>
        <item name="innerCornerSize">50%</item>
    </style>

    <style name="Widget.BMICalculator.UnitToggleButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">@dimen/unit_toggle_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Widget.BMICalculator.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="helperTextEnabled">true</item>
        <item name="errorEnabled">true</item>
        <item name="boxStrokeWidthFocused">@dimen/text_field_stroke_width_focused</item>
    </style>

    <!-- A number field that accepts either decimal separator; NumberInput parses both. -->
    <style name="Widget.BMICalculator.DecimalInput" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:inputType">numberDecimal</item>
        <item name="android:digits">0123456789.,</item>
        <item name="android:maxLength">6</item>
    </style>

    <!--
        A compound unit such as feet and inches is typed into two fields side by side: a whole
        field and a part field. Hidden until a compound unit is selected.
    -->
    <style name="Widget.BMICalculator.CompoundRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:baselineAligned">false</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="Widget.BMICalculator.WholeField" parent="Widget.BMICalculator.TextInputLayout">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginEnd">@dimen/field_spacing</item>
    </style>

    <style name="Widget.BMICalculator.PartField" parent="Widget.BMICalculator.TextInputLayout">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
    </style>

    <!-- Whole feet or stones: digits only. -->
    <style name="Widget.BMICalculator.WholeInput" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:inputType">number</item>
        <item name="android:maxLength">2</item>
    </style>

    <!-- Inches or pounds below one whole unit, e.g. "11.5". -->
    <style name="Widget.BMICalculator.PartInput" parent="Widget.BMICalculator.DecimalInput">
        <item name="android:maxLength">4</item>
    </style>

    <style name="Widget.BMICalculator.ResultCard" parent="Widget.Material3.CardView.Outlined">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/section_spacing</item>
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerLow</item>
    </style>

    <!-- Category name on a background of the category's color. -->
    <style name="Widget.BMICalculator.CategoryPill" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/item_spacing</item>
        <item name="android:background">@drawable/bg_category_pill</item>
        <item name="android:paddingHorizontal">@dimen/category_pill_padding_horizontal</item>
        <item name="android:paddingVertical">@dimen/category_pill_padding_vertical</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
        <item name="android:textColor">@color/bmi_on_category</item>
    </style>

    <style name="TextAppearance.BMICalculator.BmiValue" parent="TextAppearance.Material3.DisplayMedium">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.BMICalculator.CategoryRow" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- The user's own category, on its tinted row. -->
    <style name="TextAppearance.BMICalculator.CategoryRow.Current">
        <item name="android:textStyle">bold</item>
    </style>

</resources>
