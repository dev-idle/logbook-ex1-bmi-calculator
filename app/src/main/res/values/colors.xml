<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        BMI category colors for the light theme. Each has a contrast ratio of at least 5:1 with
        bmi_on_category, above the WCAG 2.2 AA minimum of 4.5:1 for text. Colors move from blue
        through green to red as health risk increases, and every color is shown next to its
        label, so the result never depends on color alone.
    -->
    <color name="bmi_underweight">#1D4ED8</color>
    <color name="bmi_healthy_weight">#15803D</color>
    <color name="bmi_overweight">#B45309</color>
    <color name="bmi_obesity_class_1">#C2410C</color>
    <color name="bmi_obesity_class_2">#B91C1C</color>
    <color name="bmi_obesity_class_3">#7F1D1D</color>

    <!-- Text drawn on top of a category color. -->
    <color name="bmi_on_category">#FFFFFF</color>
</resources>
