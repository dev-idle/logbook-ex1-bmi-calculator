<resources>
    <string name="app_name">BMI Calculator</string>
    <string name="app_scope">For adults aged 20 and over</string>

    <!-- Unit labels shown on the toggle buttons and as field suffixes. -->
    <string name="unit_kilograms">kg</string>
    <string name="unit_pounds">lb</string>
    <string name="unit_stones">st</string>
    <string name="unit_centimeters">cm</string>
    <string name="unit_meters">m</string>
    <string name="unit_feet">ft</string>
    <string name="unit_inches">in</string>
    <string name="unit_feet_and_inches">ft / in</string>
    <string name="unit_stones_and_pounds">st / lb</string>

    <!-- Spoken by screen readers instead of the abbreviations above. -->
    <string name="unit_kilograms_description">Kilograms</string>
    <string name="unit_pounds_description">Pounds</string>
    <string name="unit_centimeters_description">Centimeters</string>
    <string name="unit_meters_description">Meters</string>
    <string name="unit_feet_and_inches_description">Feet and inches</string>
    <string name="unit_stones_and_pounds_description">Stones and pounds</string>

    <!-- Form -->
    <string name="weight_title">Weight</string>
    <string name="height_title">Height</string>
    <string name="weight_hint">Weight</string>
    <string name="height_hint">Height</string>
    <string name="feet_hint">Feet</string>
    <string name="inches_hint">Inches</string>
    <string name="stones_hint">Stones</string>
    <string name="pounds_hint">Pounds</string>
    <string name="calculate">Calculate BMI</string>
    <string name="clear">Clear</string>

    <!--
        Accepted ranges, e.g. "10 to 400 kg" or "1 ft 7.7 in to 8 ft 2.4 in". A number and its
        unit are joined by a no-break space (\u00A0) so a line never breaks between them.
    -->
    <string name="range_with_unit">%1$s to %2$s\u00A0%3$s</string>
    <string name="range">%1$s to %2$s</string>
    <!-- A value and its unit, e.g. "56.7 kg". -->
    <string name="value_with_unit">%1$s\u00A0%2$s</string>
    <!-- A compound value, e.g. "5 ft 8.9 in": whole, its unit, part, its unit. -->
    <string name="compound_value">%1$d\u00A0%2$s %3$s\u00A0%4$s</string>

    <!--
        Validation messages, worded after Shneiderman's guidelines for error messages: positive,
        precise, and saying how to fix the problem rather than only that there is one.
    -->
    <string name="error_weight_required">Please enter your weight</string>
    <string name="error_height_required">Please enter your height</string>
    <string name="error_feet_required">Please enter your height in feet</string>
    <string name="error_not_a_number">Enter digits with at most one decimal point</string>
    <string name="error_not_whole_feet">Enter whole feet and put the rest in inches</string>
    <string name="error_inches_out_of_range">Enter less than 12 inches, as 12 inches make a foot</string>
    <string name="error_stones_required">Please enter your weight in stones</string>
    <string name="error_not_whole_stones">Enter whole stones and put the rest in pounds</string>
    <string name="error_pounds_out_of_range">Enter less than 14 pounds, as 14 pounds make a stone</string>
    <!-- %1$s is an accepted range such as "10 to 400 kg". -->
    <string name="error_weight_out_of_range">Enter a weight from %1$s</string>
    <string name="error_height_out_of_range">Enter a height from %1$s</string>

    <!-- Result -->
    <string name="result_title">Your BMI</string>
    <!-- Read by screen readers, e.g. "Your BMI is 22.9: Healthy weight". -->
    <string name="result_summary_description">Your BMI is %1$s: %2$s</string>
    <string name="category_list_title">BMI categories for adults</string>
    <!-- Category ranges in the CDC's wording, e.g. "18.5 to less than 25". -->
    <string name="category_range_below">Less than %1$s</string>
    <string name="category_range_between">%1$s to less than %2$s</string>
    <string name="category_range_above">%1$s or greater</string>
    <!-- Read by screen readers for each row of the category list. -->
    <string name="category_row_description">%1$s: BMI %2$s</string>
    <string name="category_row_current_description">%1$s: BMI %2$s. This is your category.</string>
    <!-- %1$s and %2$s are weights with their unit, e.g. "56.7 kg" and "76.2 kg". -->
    <string name="healthy_weight_range">For your height, a healthy weight is %1$s to %2$s.</string>
    <string name="adult_note">BMI categories apply to adults aged 20 and over. BMI is a screening measure, not a diagnosis.</string>

    <!-- About dialog -->
    <string name="menu_about">About BMI</string>
    <string name="about_title">About BMI</string>
    <string name="about_message">Body mass index (BMI) is your weight in kilograms divided by the square of your height in meters.\n\nIt is a quick screening measure for adults aged 20 and over, not a diagnosis of health. Children and teens are still growing, so their BMI is compared with others of the same age and sex on growth charts instead of these categories.\n\nThe categories follow the adult BMI categories published by the U.S. Centers for Disease Control and Prevention (CDC), which match the World Health Organization classification.</string>
    <string name="about_open_source">Open CDC page</string>
    <string name="about_source_url" translatable="false">https://www.cdc.gov/bmi/adult-calculator/bmi-categories.html</string>
    <string name="error_no_browser">No app on this device can open web pages</string>
    <string name="ok">OK</string>

    <!-- BMI categories, worded as in the CDC adult BMI categories. -->
    <string name="category_underweight">Underweight</string>
    <string name="category_healthy_weight">Healthy weight</string>
    <string name="category_overweight">Overweight</string>
    <string name="category_obesity_class_1">Class 1 obesity</string>
    <string name="category_obesity_class_2">Class 2 obesity</string>
    <string name="category_obesity_class_3">Class 3 obesity</string>
</resources>
