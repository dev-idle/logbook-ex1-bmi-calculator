<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup and device-transfer rules for Android 12 and later, which covers every version the
    app supports. The only stored data is the selected units, a preference worth keeping when
    the user restores or moves to a new device.
    See https://developer.android.com/identity/data/autobackup
-->
<data-extraction-rules>
    <cloud-backup>
        <include
            domain="sharedpref"
            path="unit_preferences.xml" />
    </cloud-backup>
    <device-transfer>
        <include
            domain="sharedpref"
            path="unit_preferences.xml" />
    </device-transfer>
</data-extraction-rules>
