<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup and device-transfer rules (Android 12+). Only the selected units are stored.
    See https://developer.android.com/identity/data/autobackup
-->
<data-extraction-rules>
    <cloud-backup>
        <include
            domain="sharedpref"
            path="unit_preferences.xml" />
    </cloud-backup>
    <device-transfer>
        <include
            domain="sharedpref"
            path="unit_preferences.xml" />
    </device-transfer>
</data-extraction-rules>
