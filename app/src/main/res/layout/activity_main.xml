<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.MainActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true"
        app:liftOnScroll="true"
        app:liftOnScrollTargetViewId="@id/scroll_view">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:menu="@menu/menu_main"
            app:title="@string/app_name" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/content"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/screen_padding"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_max="@dimen/content_max_width">

                <!-- Weight -->

                <TextView
                    style="@style/Widget.BMICalculator.SectionTitle"
                    android:text="@string/weight_title" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/weight_unit_group"
                    style="@style/Widget.BMICalculator.UnitToggleGroup"
                    app:checkedButton="@id/button_kilograms">

                    <Button
                        android:id="@+id/button_kilograms"
                        style="@style/Widget.BMICalculator.UnitToggleButton"
                        android:contentDescription="@string/unit_kilograms_description"
                        android:text="@string/unit_kilograms" />

                    <Button
                        android:id="@+id/button_pounds"
                        style="@style/Widget.BMICalculator.UnitToggleButton"
                        android:contentDescription="@string/unit_pounds_description"
                        android:text="@string/unit_pounds" />

                    <Button
                        android:id="@+id/button_stones_and_pounds"
                        style="@style/Widget.BMICalculator.UnitToggleButton"
                        android:contentDescription="@string/unit_stones_and_pounds_description"
                        android:text="@string/unit_stones_and_pounds" />

                </com.google.android.material.button.MaterialButtonToggleGroup>

                <!-- Shown for simple weight units; the suffix is set from the unit. -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/weight_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/weight_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/weight_input"
                        style="@style/Widget.BMICalculator.DecimalInput"
                        android:imeOptions="actionNext" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Shown for stones and pounds. -->
                <LinearLayout
                    android:id="@+id/weight_compound_row"
                    style="@style/Widget.BMICalculator.CompoundRow">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/stones_layout"
                        style="@style/Widget.BMICalculator.WholeField"
                        android:hint="@string/stones_hint"
                        app:suffixText="@string/unit_stones">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/stones_input"
                            style="@style/Widget.BMICalculator.WholeInput"
                            android:imeOptions="actionNext" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/weight_pounds_layout"
                        style="@style/Widget.BMICalculator.PartField"
                        android:hint="@string/pounds_hint"
                        app:suffixText="@string/unit_pounds">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/weight_pounds_input"
                            style="@style/Widget.BMICalculator.PartInput"
                            android:imeOptions="actionNext" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

                <!-- Height -->

                <TextView
                    style="@style/Widget.BMICalculator.SectionTitle"
                    android:layout_marginTop="@dimen/section_spacing"
                    android:text="@string/height_title" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/height_unit_group"
                    style="@style/Widget.BMICalculator.UnitToggleGroup"
                    app:checkedButton="@id/button_centimeters">

                    <Button
                        android:id="@+id/button_centimeters"
                        style="@style/Widget.BMICalculator.UnitToggleButton"
                        android:contentDescription="@string/unit_centimeters_description"
                        android:text="@string/unit_centimeters" />

                    <Button
                        android:id="@+id/button_meters"
                        style="@style/Widget.BMICalculator.UnitToggleButton"
                        android:contentDescription="@string/unit_meters_description"
                        android:text="@string/unit_meters" />

                    <Button
                        android:id="@+id/button_feet_and_inches"
                        style="@style/Widget.BMICalculator.UnitToggleButton"
                        android:contentDescription="@string/unit_feet_and_inches_description"
                        android:text="@string/unit_feet_and_inches" />

                </com.google.android.material.button.MaterialButtonToggleGroup>

                <!-- Shown for simple height units; the suffix is set from the unit. -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/height_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/height_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/height_input"
                        style="@style/Widget.BMICalculator.DecimalInput"
                        android:imeOptions="actionDone" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Shown for feet and inches. -->
                <LinearLayout
                    android:id="@+id/height_compound_row"
                    style="@style/Widget.BMICalculator.CompoundRow">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/feet_layout"
                        style="@style/Widget.BMICalculator.WholeField"
                        android:hint="@string/feet_hint"
                        app:suffixText="@string/unit_feet">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/feet_input"
                            style="@style/Widget.BMICalculator.WholeInput"
                            android:imeOptions="actionNext" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/inches_layout"
                        style="@style/Widget.BMICalculator.PartField"
                        android:hint="@string/inches_hint"
                        app:suffixText="@string/unit_inches">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inches_input"
                            style="@style/Widget.BMICalculator.PartInput"
                            android:imeOptions="actionDone" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

                <!-- Actions -->

                <Button
                    android:id="@+id/calculate_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/section_spacing"
                    android:text="@string/calculate" />

                <Button
                    android:id="@+id/clear_button"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_spacing"
                    android:text="@string/clear" />

                <!-- Result -->

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/result_card"
                    style="@style/Widget.BMICalculator.ResultCard"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!--
                            Screen readers announce this summary whenever it changes, as one
                            sentence set from code, rather than reading the whole card.
                        -->
                        <LinearLayout
                            android:id="@+id/result_summary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:accessibilityLiveRegion="polite"
                            android:focusable="true"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:importantForAccessibility="no"
                                android:text="@string/result_title"
                                android:textAppearance="?attr/textAppearanceLabelLarge" />

                            <TextView
                                android:id="@+id/bmi_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:importantForAccessibility="no"
                                android:textAppearance="@style/TextAppearance.BMICalculator.BmiValue"
                                tools:text="22.9" />

                            <TextView
                                android:id="@+id/category_label"
                                style="@style/Widget.BMICalculator.CategoryPill"
                                android:importantForAccessibility="no"
                                tools:backgroundTint="@color/bmi_healthy_weight"
                                tools:text="@string/category_healthy_weight" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/healthy_range"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/field_spacing"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            tools:text="For your height, a healthy weight is 56.7 to 76.2 kg." />

                        <com.google.android.material.divider.MaterialDivider
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginVertical="@dimen/field_spacing" />

                        <TextView
                            style="@style/Widget.BMICalculator.SectionTitle"
                            android:text="@string/category_scale_title"
                            android:textAppearance="?attr/textAppearanceTitleSmall" />

                        <!-- Filled from code with one item_bmi_category row per category. -->
                        <LinearLayout
                            android:id="@+id/category_scale"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/field_spacing"
                            android:text="@string/adult_note"
                            android:textAppearance="?attr/textAppearanceBodySmall" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
